# Denim Universe — Supabase Configuration
# Replace these values with your actual Project URL and Public Anon Key from:
# Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Google Analytics 4 (or configure directly in Admin Panel Settings)
VITE_GA_MEASUREMENT_ID=G-XEYN7P0ZQM

# Automatic Welcome Emails (Resend - 3,000 free emails/month)
# Obtain from https://resend.com/api-keys and add in Vercel Project Environment Variables:
RESEND_API_KEY=re_your_resend_api_key_here
# Optional custom sender (defaults to "Denim Universe <onboarding@resend.dev>"):
# RESEND_FROM_EMAIL=Denim Universe <hello@denimuniverse.com>
