# Denim Universe — Supabase Configuration
# Replace these values with your actual Project URL and Public Anon Key from:
# Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Google Analytics 4 (or configure directly in Admin Panel Settings)
VITE_GA_MEASUREMENT_ID=G-XEYN7P0ZQM

# Automatic Welcome Emails — Option A: Resend (Requires custom domain verification at resend.com/domains)
RESEND_API_KEY=re_your_resend_api_key_here
# RESEND_FROM_EMAIL=Denim Universe <hello@yourverifieddomain.com>

# Automatic Welcome Emails — Option B: Brevo (No custom domain required! Works with any verified Gmail)
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here
# BREVO_SENDER_EMAIL=asif.hdlplan@gmail.com
# BREVO_SENDER_NAME=Denim Universe
